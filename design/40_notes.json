{
  "dataset": {
    "name": "echo_ground_truth_v1",
    "topic": "Creative writing",
    "description": "40 notes as they would actually exist in a working creative's second brain; half-finished article drafts, voice memos with filler words and trailing thoughts, image-sourced quotes, mood board captions, unconnected observations about daily life, and fragments that go nowhere. Semantic relationships span all three tiers, including genuine NONE pairs where no connection exists.",
    "version": "1.0",
    "note_count": 40,
    "annotation_schema": {
      "STRONG": "The core subject is the same or directly builds on the same idea. A user would almost certainly want to navigate from one note to the other.",
      "WEAK": "The notes share a theme or domain but address different aspects of it. The connection is plausible but not the first thing a user would look for.",
      "NONE": "No meaningful connection. A user navigating from one note would not expect to arrive at the other."
    },
    "note_types_used": {
      "text": "Raw typed note: body is the direct content",
      "audio": "Voice memo: body is the Whisper transcript, embedding_text includes transcript",
      "image": "Embedded image: body is user annotation (may be null), embedding_text is concatenation of BLIP caption + Surya OCR text + body"
    },
    "clusters": {
      "C1": "Narrative structure and story architecture",
      "C2": "Character, voice, and dialogue",
      "C3": "Language, style, and sentence-level craft",
      "C4": "Creative process, habits, and blocks",
      "C5": "Quoted material — typed, photographed, or recorded",
      "C6": "Half-formed article and essay drafts",
      "C7": "Unconnected daily life observations and thoughts",
      "C8": "Mood board images and visual inspiration"
    }
  },

